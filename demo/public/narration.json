    "ondam-question": {
      "src": "/assets/narration/20261007/ondam-question.mp3",
      "duration": 18.03,
      "source_start": 0.0,
      "source_end": 18.03,
      "source_start_frame": 0,
      "source_end_frame": 865440,
      "source_file": "PLFSS 03.wav",
      "source_sha256": "703e6466199f7d66ba14f981f8ac9753738abf67d12b04fb8056911949383ba9",
      "sha256": "90171bd03e5430fc113da7631e3124d7f1dd73306c2a40e7c164d6152c246177",
      "text": "Quel objectif de dépenses de santé est proposé pour 2027, et comment se répartit-il ? Nous allons examiner l’O.N.D.A.M. et ses sous-objectifs. Cette lecture complète les comptes des branches, elle ne doit pas être additionnée à la branche Maladie.",
      "fade_in_seconds": 0,
      "fade_out_seconds": 0,
      "decoded_frames": 865440
    },
    "ondam-definition": {
      "src": "/assets/narration/20261007/ondam-definition.mp3",
      "duration": 15.769999999999996,
      "source_start": 18.03,
      "source_end": 33.8,
      "source_start_frame": 865440,
      "source_end_frame": 1622400,
      "source_file": "PLFSS 03.wav",
      "source_sha256": "703e6466199f7d66ba14f981f8ac9753738abf67d12b04fb8056911949383ba9",
      "sha256": "c2f48e805fe506af75416be7ec7aa39bd4ef85f325dc2fae9d12e952221fe6e3",
      "text": "L’objectif national de dépenses d’assurance maladie est présenté dans sa propre rubrique. Son périmètre diffère des comptes de la branche Maladie. Les mêmes précautions s’appliquent : exercice, étape, périmètre, unité et source doivent rester identifiés.",
      "fade_in_seconds": 0,
      "fade_out_seconds": 0,
      "decoded_frames": 756960
    },
