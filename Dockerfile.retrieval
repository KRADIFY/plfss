ARG PLFSS_RETRIEVAL_BASE=lexmachine-budget-retrieval:20260924-final
FROM ${PLFSS_RETRIEVAL_BASE}
WORKDIR /app
COPY plfss_service /app/plfss_service
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 HF_HUB_DISABLE_TELEMETRY=1 TORCHINDUCTOR_CACHE_DIR=/tmp/torch XDG_CACHE_HOME=/tmp/cache
USER 10001:10001
EXPOSE 8090
CMD ["python", "-m", "plfss_service.retrieval_service"]
